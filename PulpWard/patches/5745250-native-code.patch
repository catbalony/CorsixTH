diff --git a/tools/native_output_integrity.py b/tools/native_output_integrity.py
new file mode 100644
index 0000000..741be3a
--- /dev/null
+++ b/tools/native_output_integrity.py
@@ -0,0 +1,180 @@
+"""Fail-closed verification of generated private Theme Hospital native tables.
+
+Checks only the builder's append-only contract; never requires or bundles
+proprietary original resources. Call before making a new private install visible.
+"""
+from __future__ import annotations
+
+import hashlib
+import struct
+from pathlib import Path
+
+NAMES = ('VStart-1.ani', 'VFra-1.ani', 'VList-1.ani',
+         'VEle-1.ani', 'VSpr-0.dat', 'VSpr-0.tab')
+
+
+def _u16(data: bytes, index: int) -> int:
+    return struct.unpack_from('<H', data, index)[0]
+
+
+def _u32(data: bytes, index: int) -> int:
+    return struct.unpack_from('<I', data, index)[0]
+
+
+def _check_new_sprite(payload: bytes, width: int, height: int, sprite_id: int) -> None:
+    if not width or not height:
+        raise ValueError(f'New sprite {sprite_id} has zero dimensions')
+    pos = 0
+    drawn = 0
+    area = width * height
+    while drawn < area:
+        if pos >= len(payload):
+            raise ValueError(f'Truncated native RLE in sprite {sprite_id}')
+        token = payload[pos]
+        pos += 1
+        if token == 0:  # Newly authored sprites never use native end-of-line opcodes.
+            raise ValueError(f'Unexpected native RLE line command in sprite {sprite_id}')
+        if token < 128:
+            if pos + token > len(payload):
+                raise ValueError(f'Truncated literal in sprite {sprite_id}')
+            pos += token
+            drawn += token
+        else:
+            drawn += 256 - token
+        if drawn > area:
+            raise ValueError(f'Native RLE overflows sprite {sprite_id}')
+    if pos != len(payload):
+        raise ValueError(f'Trailing native RLE data in sprite {sprite_id}')
+
+
+
+def validate_material_rewrite(before_ids: list[int], after_ids: list[int],
+                              elements: bytes | bytearray, sprite_table: bytes | bytearray,
+                              selected_sprites: frozenset[int], label: str) -> None:
+    """Verify a layered palette change without flattening or shifting geometry.
+
+    Called for *each* rewritten material frame against the composition that
+    existed immediately before that material pass. This also covers GP frames
+    which already contain a newly generated doctor between desk components.
+    """
+    if len(before_ids) != len(after_ids):
+        raise ValueError(f'{label}: changed native layer count')
+    if len(elements) % 6 or len(sprite_table) % 6:
+        raise ValueError(f'{label}: malformed native element/sprite table')
+    element_count = len(elements) // 6
+    sprite_count = len(sprite_table) // 6
+    replacements = 0
+    for index, (before_id, after_id) in enumerate(zip(before_ids, after_ids)):
+        if not 0 <= before_id < element_count or not 0 <= after_id < element_count:
+            raise ValueError(f'{label}: invalid layer element at {index}')
+        old = elements[before_id * 6:before_id * 6 + 6]
+        new = elements[after_id * 6:after_id * 6 + 6]
+        old_ref, new_ref = _u16(old, 0), _u16(new, 0)
+        if (old_ref % 6 or new_ref % 6 or
+                old_ref // 6 >= sprite_count or new_ref // 6 >= sprite_count):
+            raise ValueError(f'{label}: invalid sprite reference at layer {index}')
+        old_sprite, new_sprite = old_ref // 6, new_ref // 6
+        if old_sprite not in selected_sprites:
+            if before_id != after_id:
+                raise ValueError(f'{label}: non-material layer replaced at {index}')
+            continue
+        replacements += 1
+        if before_id == after_id or old_sprite == new_sprite:
+            raise ValueError(f'{label}: selected material layer was not replaced at {index}')
+        if old[2:] != new[2:]:
+            raise ValueError(f'{label}: offset or conditional layer flags changed at {index}')
+        if (sprite_table[old_sprite * 6 + 4:old_sprite * 6 + 6] !=
+                sprite_table[new_sprite * 6 + 4:new_sprite * 6 + 6]):
+            raise ValueError(f'{label}: material sprite dimensions changed at {index}')
+    if not replacements:
+        raise ValueError(f'{label}: no selected material sprite in frame')
+
+def validate_native_output(source: Path, output: Path, manifest: dict) -> None:
+    """Validate timing, frame indirection, ordered elements and appended RLE.
+
+    Original record bytes must be immutable. Modified frames may only change
+    their VList offset, never the engine's next-frame/time/sound/flags bytes.
+    """
+    before = [(source / name).read_bytes() for name in NAMES]
+    after = [(output / name.upper()).read_bytes() for name in NAMES]
+    start, frames, lists, elems, dat, tab = before
+    new_start, new_frames, new_lists, new_elems, new_dat, new_tab = after
+
+
+    for table, data, width in [('VFra', frames, 10), ('VList', lists, 2),
+                               ('VEle', elems, 6), ('VSpr.tab', tab, 6)]:
+        if len(data) % width:
+            raise ValueError(f'Unaligned original {table} table')
+    if new_start != start:
+        raise ValueError('Native animation start table changed')
+    if len(new_frames) != len(frames):
+        raise ValueError('Native animation frame count changed')
+    for name, old, new in [('VList', lists, new_lists), ('VEle', elems, new_elems),
+                            ('VSpr.dat', dat, new_dat), ('VSpr.tab', tab, new_tab)]:
+        if not new.startswith(old):
+            raise ValueError(f'Original {name} resource was changed')
+    if len(new_lists) % 2 or len(new_elems) % 6 or len(new_tab) % 6:
+        raise ValueError('Appended native tables are not record-aligned')
+    if len(new_tab) // 6 > 10923:  # sprite ID stored as 6-byte offset in u16
+        raise ValueError('Native sprite-table offset exceeds 16 bits')
+
+    old_list_count = len(lists) // 2
+    element_count = len(new_elems) // 6
+    sprite_count = len(new_tab) // 6
+    changed = set()
+    for fid in range(len(frames) // 10):
+        position = fid * 10
+        if new_frames[position + 4:position + 10] != frames[position + 4:position + 10]:
+            raise ValueError(f'Native timing/flags/next-frame changed in frame {fid}')
+        old_index = _u32(frames, position)
+        new_index = _u32(new_frames, position)
+        if old_index == new_index:
+            continue
+        changed.add(fid)
+        if new_index < old_list_count or new_index >= len(new_lists) // 2:
+            raise ValueError(f'Frame {fid} points outside appended element lists')
+        for step in range(128):
+            index = (new_index + step) * 2
+            if index + 2 > len(new_lists):
+                raise ValueError(f'Unterminated new element list in frame {fid}')
+            eid = _u16(new_lists, index)
+            if eid == 0xffff:
+                break
+            if eid >= element_count:
+                raise ValueError(f'Frame {fid} refers to missing element {eid}')
+        else:
+            raise ValueError(f'Unterminated new element list in frame {fid}')
+
+    expected = {int(row[2]) for row in manifest['entries']}
