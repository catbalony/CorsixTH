+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+from native_output_integrity import validate_material_rewrite, validate_native_output, NAMES
+from build_private_native_swap import CAST, build
+
+
+class LayerContractTests(unittest.TestCase):
+    def setUp(self):
+        # One selected cabinet layer, one non-material actor, and one clone.
+        self.elements = bytearray()
+        self.elements.extend(struct.pack('<HBBBB', 0, 144, 190, 3, 8))
+        self.elements.extend(struct.pack('<HBBBB', 6, 145, 185, 0, 2))
+        self.elements.extend(struct.pack('<HBBBB', 12, 144, 190, 3, 8))
+        self.tab = bytearray()
+        for offset, w, h in ((0, 9, 11), (4, 8, 15), (7, 9, 11)):
+            self.tab.extend(struct.pack('<IBB', offset, w, h))
+        self.selected = frozenset({0})
+
+    def check(self, after=None, elements=None, tab=None):
+        validate_material_rewrite([0, 1], [2, 1] if after is None else after,
+                                  self.elements if elements is None else elements,
+                                  self.tab if tab is None else tab,
+                                  self.selected, 'machine frame')
+
+    def test_valid_recolour_keeps_layer_count_order_flags_and_dimensions(self):
+        self.check()
+
+    def test_missing_or_reordered_elements_fail(self):
+        for value, msg in (([2], 'layer count'), ([1, 2], 'offset or conditional layer flags')):
+            with self.subTest(value=value), self.assertRaisesRegex(ValueError, msg):
+                self.check(value)
+
+    def test_changing_actor_layer_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, 'non-material layer'):
+            self.check([2, 0])
+
+    def test_changing_native_offset_or_conditions_is_rejected(self):
+        modified = bytearray(self.elements)
+        modified[2 * 6 + 3] ^= 1
+        with self.assertRaisesRegex(ValueError, 'offset or conditional layer flags'):
+            self.check(elements=modified)
+
+    def test_material_sprite_shape_must_be_unchanged(self):
+        modified = bytearray(self.tab)
+        modified[2 * 6 + 4] = 10
+        with self.assertRaisesRegex(ValueError, 'sprite dimensions'):
+            self.check(tab=modified)
+
+    def test_dangling_indices_are_rejected(self):
+        with self.assertRaisesRegex(ValueError, 'invalid layer element'):
+            self.check([3, 1])
+        corrupted = bytearray(self.elements)
+        struct.pack_into('<H', corrupted, 2 * 6, 17)
+        with self.assertRaisesRegex(ValueError, 'invalid sprite reference'):
+            self.check(elements=corrupted)
+
+    def test_unselected_frame_is_not_treated_as_a_successful_material_pass(self):
+        with self.assertRaisesRegex(ValueError, 'no selected material sprite'):
+            validate_material_rewrite([1], [1], self.elements, self.tab,
+                                      self.selected, 'machine frame')
+
+
+class BuildFingerprintTests(unittest.TestCase):
+    def test_reproducible_private_fingerprints_and_corruption(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            source = root / 'source'
+            source.mkdir()
+            start = bytearray((max(CAST['doctor']) + 1) * 4)
+            frames = bytearray()
+            for i, anim in enumerate(CAST['doctor']):
+                struct.pack_into('<H', start, anim * 4, i)
+                frames.extend(struct.pack('<IBBBBH', 0, 0, 0, 0, 0, i))
+            originals = (start, frames, struct.pack('<HH', 0, 0xffff),
+                         struct.pack('<HBBBB', 0, 141, 186, 0, 0),
+                         b'\x01\x01', struct.pack('<IBB', 0, 1, 1))
+            for name, contents in zip(NAMES, originals):
+                (source / name).write_bytes(contents)
+            a = root / 'a'
+            b = root / 'b'
+            manifest = build(source, a, ['doctor'])
+            second = build(source, b, ['doctor'])
+            self.assertEqual(manifest['input_sha256'], second['input_sha256'])
+            self.assertEqual(manifest['output_sha256'], second['output_sha256'])
+            for name in NAMES:
+                self.assertEqual(manifest['input_sha256'][name],
+                                 hashlib.sha256((source / name).read_bytes()).hexdigest())
+                self.assertEqual(manifest['output_sha256'][name],
+                                 hashlib.sha256((a / name.upper()).read_bytes()).hexdigest())
+            validate_native_output(source, a, manifest)
+            forged = dict(manifest)
+            forged['output_sha256'] = dict(manifest['output_sha256'])
+            forged['output_sha256']['VFra-1.ani'] = '00' * 32
+            with self.assertRaisesRegex(ValueError, 'fingerprints do not match'):
+                validate_native_output(source, a, forged)
+
+
+if __name__ == '__main__':
+    unittest.main()
