index 0000000..fe9ed1f
--- /dev/null
+++ b/tests/test_native_integrity_gate.py
@@ -0,0 +1,173 @@
+"""Synthetic, copyright-free native integrity and transactional install checks."""
+from __future__ import annotations
+
+from pathlib import Path
+import struct
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+from build_private_native_swap import CAST, build
+from native_output_integrity import validate_native_output
+import prepare_private_native_swap as prepare_module
+
+
+NAMES = ('VStart-1.ani', 'VFra-1.ani', 'VList-1.ani',
+         'VEle-1.ani', 'VSpr-0.dat', 'VSpr-0.tab')
+
+
+def native_source(root: Path) -> Path:
+    """Tiny standalone original-format resource set; no Bullfrog pixels."""
+    source = root / 'decoded'
+    source.mkdir()
+    start = bytearray((max(CAST['doctor']) + 1) * 4)
+    frames = bytearray()
+    for index, anim in enumerate(CAST['doctor']):
+        struct.pack_into('<H', start, anim * 4, index)
+        frames.extend(struct.pack('<IBBBBH', 0, 10, 20, 30, 40, index))
+    parts = (start, frames, struct.pack('<HH', 0, 0xffff),
+             struct.pack('<HBBBB', 0, 141, 186, 0, 0),
+             b'\x01\x07', struct.pack('<IBB', 0, 1, 1))
+    for filename, contents in zip(NAMES, parts):
+        (source / filename).write_bytes(contents)
+    return source
+
+
+class NativeIntegrityGate(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.source = native_source(self.root)
+        self.target = self.root / 'generated'
+        self.manifest = build(self.source, self.target, ['doctor'])
+
+    def validate(self):
+        validate_native_output(self.source, self.target, self.manifest)
+
+    def corrupt(self, filename: str, offset: int, value: int):
+        path = self.target / filename
+        data = bytearray(path.read_bytes())
+        data[offset] = value
+        path.write_bytes(data)
+
+    def test_valid_output_and_repeat_build_are_identical(self):
+        self.validate()
+        other = self.root / 'again'
+        build(self.source, other, ['doctor'])
+        for name in NAMES:
+            self.assertEqual((self.target / name.upper()).read_bytes(),
+                             (other / name.upper()).read_bytes())
+
+    def test_timing_and_frame_links_fail_closed(self):
+        self.corrupt('VFRA-1.ANI', 4, 99)
+        with self.assertRaisesRegex(ValueError, 'timing/flags/next-frame'):
+            self.validate()
+
+    def test_original_sprite_prefix_mutation_fails_closed(self):
+        self.corrupt('VSPR-0.DAT', 1, 8)
+        with self.assertRaisesRegex(ValueError, 'Original VSpr.dat'):
+            self.validate()
+
+    def test_new_sprite_offset_and_run_corruption_fail_closed(self):
+        sid = 1  # first appended native sprite
+        self.corrupt('VSPR-0.TAB', sid * 6, 0)
+        with self.assertRaisesRegex(ValueError, 'offset is not contiguous'):
+            self.validate()
+
+    def test_corrupt_native_rle_fails_closed(self):
+        old_length = len((self.source / 'VSpr-0.dat').read_bytes())
+        self.corrupt('VSPR-0.DAT', old_length, 0)
+        with self.assertRaisesRegex(ValueError, 'line command'):
+            self.validate()
+
+    def test_dangling_frame_element_fails_closed(self):
+        path = self.target / 'VELE-1.ANI'
+        data = bytearray(path.read_bytes())
+        struct.pack_into('<H', data, 6, 65532)
+        path.write_bytes(data)
+        with self.assertRaisesRegex(ValueError, 'invalid sprite-table reference'):
+            self.validate()
+
+    def test_unexpected_frame_list_mutation_fails_closed(self):
+        self.corrupt('VFRA-1.ANI', 0, 0)
+        with self.assertRaisesRegex(ValueError, 'Unexpected set of modified native frames'):
+            self.validate()
+
+
+class TransactionalPrivatePrepare(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.original = self.root / 'original-game'
+        for dirname in ('DATA', 'QDATA', 'DATAM', 'QDATAM', 'LEVELS'):
+            (self.original / dirname).mkdir(parents=True)
+            (self.original / dirname / 'sentinel.txt').write_text(dirname)
+        for name in prepare_module.PATCH_NAMES:
+            (self.original / 'DATA' / name.lower()).write_bytes(b'original')
+        self.out = self.root / 'prepared-game'
+        self.source = self.root / 'decoded'
+        self.source.mkdir()
+
+    def fake_build(self, src, output, *args, **kwargs):
+        output.mkdir()
+        for name in prepare_module.PATCH_NAMES:
+            (output / name).write_bytes(b'patched-' + name.encode('ascii'))
+        return {'frame_replacements': 1, 'unique_frames_modified': 1, 'objects': []}
+
+    def prepare(self):
+        with patch.object(prepare_module, 'build', side_effect=self.fake_build):
+            return prepare_module.prepare(self.original, self.source, self.out)
+
+    def test_complete_copy_only_visible_after_success(self):
+        result = self.prepare()
+        self.assertEqual(result['frame_replacements'], 1)
+        self.assertEqual((self.out / 'LEVELS' / 'sentinel.txt').read_text(), 'LEVELS')
+        for name in prepare_module.PATCH_NAMES:
+            self.assertEqual((self.out / 'DATA' / name.lower()).read_bytes(),
+                             b'patched-' + name.encode('ascii'))
+            self.assertEqual((self.original / 'DATA' / name.lower()).read_bytes(), b'original')
+        self.assertEqual(list(self.root.glob('.prepared-game.staging-*')), [])
+
+    def test_interrupted_copy_does_not_publish(self):
+        copytree = prepare_module.shutil.copytree
+        calls = 0
+        def interrupt(src, dst, *args, **kwargs):
+            nonlocal calls
+            calls += 1
+            if calls == 2:
+                raise OSError('synthetic copy interruption')
+            return copytree(src, dst, *args, **kwargs)
+        with patch.object(prepare_module, 'build', side_effect=self.fake_build), \
+             patch.object(prepare_module.shutil, 'copytree', side_effect=interrupt):
+            with self.assertRaisesRegex(OSError, 'interruption'):
+                prepare_module.prepare(self.original, self.source, self.out)
+        self.assertFalse(self.out.exists())
+        self.assertEqual(list(self.root.glob('.prepared-game.staging-*')), [])
+
+    def test_existing_destination_is_never_changed(self):
+        self.out.mkdir()
+        (self.out / 'owner.txt').write_text('keep')
+        with self.assertRaises(FileExistsError):
+            self.prepare()
+        self.assertEqual((self.out / 'owner.txt').read_text(), 'keep')
+
+    def test_destination_appearing_during_copy_is_never_overwritten(self):
+        publish = prepare_module._publish_without_replacement
+        def race(stage, target):
+            target.mkdir()
+            (target / 'owner.txt').write_text('created-by-another-run')
+            publish(stage, target)
+        with patch.object(prepare_module, 'build', side_effect=self.fake_build), \
+             patch.object(prepare_module, '_publish_without_replacement', side_effect=race):
+            with self.assertRaises(FileExistsError):
+                prepare_module.prepare(self.original, self.source, self.out)
+        self.assertEqual((self.out / 'owner.txt').read_text(), 'created-by-another-run')
+        self.assertEqual(list(self.root.glob('.prepared-game.staging-*')), [])
+
+    def test_owned_source_is_never_a_valid_destination(self):
+        with self.assertRaisesRegex(ValueError, 'original game directory'):
+            prepare_module.prepare(self.original, self.source, self.original / 'DATA' / 'new')
